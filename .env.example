# Copy to `.env` and fill in. `.env` is git-ignored.

# Application under test
BASE_URL=https://pre-sakani.housingapps.sa

# Pre-production beneficiary identity used for authenticated journeys.
# Nafath auto-approves this identifier in pre-production (no phone needed).
SAKANI_NATIONAL_ID=1000011485

# UI language for the app shell: ar | en
SAKANI_LANG=en

# Booking test data (see src/data/testData.ts for how these are used)
# Project that is bookable AND has non-beneficiary inventory.
BOOKING_PROJECT_ID=2896
# Project used to assert the "one booking per project" negative rule.
BOOKED_PROJECT_ID=1441
# Project whose bookings are closed (start_booking returns 403).
CLOSED_PROJECT_ID=1187

# Run all three browsers instead of chromium only
# ALL_BROWSERS=1
